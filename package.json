{
  "name": "eslint-plugin-importer",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "pnpm@11.17.0",
  "description": "An ESLint plugin that is a subset of eslint-plugin-import.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/eslint-plugin-importer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/eslint-plugin-importer.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/eslint-plugin-importer/issues"
  },
  "keywords": [
    "eslint",
    "plugin",
    "import"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "eslint-typegen.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "node scripts/typegen.ts && tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsgo --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.3.1",
    "@sxzz/prettier-config": "^2.3.2",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/utils": "^8.65.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bumpp": "^12.0.0",
    "eslint": "^10.8.0",
    "eslint-typegen": "^2.3.1",
    "eslint-vitest-rule-tester": "^3.1.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "tsdown-preset-sxzz": "^0.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "prettier": "@sxzz/prettier-config"
}
